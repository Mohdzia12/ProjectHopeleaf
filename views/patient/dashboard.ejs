<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Patient Dashboard | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 7px;
        }

        ::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>


<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen flex">


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col">

        <!-- LOGO -->

        <div class="px-6 py-6 border-b border-slate-100">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-sm">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 21s8-4.5 8-10.5A4.5 4.5 0 0012 7a4.5 4.5 0 00-8 3.5C4 16.5 12 21 12 21z"
                        />
                    </svg>

                </div>

                <div>
                    <h1 class="text-xl font-bold text-emerald-600">
                        HopeLeaf
                    </h1>

                    <p class="text-xs text-slate-400 mt-0.5">
                        Patient Portal
                    </p>
                </div>

            </div>

        </div>


        <!-- NAVIGATION -->

        <nav class="p-4 space-y-1.5 flex-1">

            <!-- Dashboard -->

            <a
                href="/patient/dashboard"
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-50 text-emerald-700 font-medium"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 10.5L12 3l9 7.5v9a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 19.5v-9z"
                    />
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 21v-6h6v6"
                    />
                </svg>

                <span>Dashboard</span>

            </a>


            <!-- Appointments -->

            <a
                href="http://localhost:8052"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <rect
                        x="3"
                        y="4.5"
                        width="18"
                        height="16"
                        rx="2"
                    />

                    <path
                        stroke-linecap="round"
                        d="M16 2.5v4M8 2.5v4M3 9h18"
                    />

                </svg>

                <span>Appointments</span>

            </a>


            <!-- Prescriptions -->

            <a
                href="/prescriptions/patient"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 3h7l4 4v14H7a2 2 0 01-2-2V5a2 2 0 012-2z"
                    />

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14 3v5h5"
                    />

                    <path
                        stroke-linecap="round"
                        d="M9 13h6M9 17h4"
                    />

                </svg>

                <span>Prescriptions</span>

            </a>


            <!-- Medical Records -->

            <a
                href="/medical-records"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 3h9l4 4v14H6a2 2 0 01-2-2V5a2 2 0 012-2z"
                    />

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 3v5h5"
                    />

                    <path
                        stroke-linecap="round"
                        d="M8 13h8M8 17h6"
                    />

                </svg>

                <span>Medical Records</span>

            </a>


            <!-- Profile -->

            <a
                href="#"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <circle cx="12" cy="8" r="3.5" />

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 20a7 7 0 0114 0"
                    />

                </svg>

                <span>My Profile</span>

            </a>

        </nav>


        <!-- SIDEBAR FOOTER -->

        <div class="p-4 border-t border-slate-100">

            <a
                href="/auth/logout"
                class="flex items-center gap-3 px-4 py-3 text-red-500 hover:bg-red-50 rounded-xl transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 17l5-5-5-5"
                    />

                    <path
                        stroke-linecap="round"
                        d="M15 12H3"
                    />

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14 4h5a2 2 0 012 2v12a2 2 0 01-2 2h-5"
                    />

                </svg>

                <span>Logout</span>

            </a>

        </div>

    </aside>



    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="flex-1 min-w-0">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="bg-white border-b border-slate-200">

            <div class="px-6 md:px-8 py-5 flex items-center justify-between">

                <div>

                    <p class="text-sm text-slate-400">
                        Patient Dashboard
                    </p>

                    <h2 class="text-2xl font-semibold text-slate-800 mt-0.5">

                        Welcome,

                        <%= user && user.name ? user.name : "Patient" %>

                    </h2>

                </div>


                <!-- PROFILE AVATAR -->

                <div
                    class="w-11 h-11 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-semibold ring-4 ring-emerald-50"
                >

                    <%
                        const displayName =
                            user && user.name
                                ? user.name
                                : "P";
                    %>

                    <%= displayName.charAt(0).toUpperCase() %>

                </div>

            </div>

        </header>



        <!-- =====================================================
             MOBILE NAVIGATION
        ====================================================== -->

        <div class="md:hidden bg-white border-b border-slate-200 px-4 py-3">

            <div class="flex gap-2 overflow-x-auto pb-1">

                <a
                    href="/patient/dashboard"
                    class="whitespace-nowrap px-4 py-2 rounded-lg bg-emerald-50 text-emerald-700 text-sm font-medium"
                >
                    Dashboard
                </a>

                <a
                    href="http://localhost:8052"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="whitespace-nowrap px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-50 text-sm"
                >
                    Appointments
                </a>

                <a
                    href="/prescriptions/patient"
                    class="whitespace-nowrap px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-50 text-sm"
                >
                    Prescriptions
                </a>

                <a
                    href="/medical-records"
                    class="whitespace-nowrap px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-50 text-sm"
                >
                    Records
                </a>

                <a
                    href="/auth/logout"
                    class="whitespace-nowrap px-4 py-2 rounded-lg text-red-500 hover:bg-red-50 text-sm"
                >
                    Logout
                </a>

            </div>

        </div>



        <!-- =====================================================
             CONTENT
        ====================================================== -->

        <section class="p-6 md:p-8 max-w-7xl mx-auto">


            <!-- =================================================
                 WELCOME BANNER
            ================================================== -->

            <div
                class="relative overflow-hidden bg-emerald-600 rounded-3xl p-7 md:p-9 text-white mb-8 shadow-sm"
            >

                <div class="relative z-10">

                    <p class="text-emerald-100 text-sm font-medium">
                        Your health journey
                    </p>

                    <h3 class="text-3xl font-semibold mt-2">
                        Welcome to HopeLeaf
                    </h3>

                    <p class="text-emerald-50 mt-3 max-w-2xl leading-relaxed">
                        Manage your appointments, prescriptions and medical
                        information from one secure healthcare space.
                    </p>

                </div>


                <!-- Decorative icon -->

                <div class="absolute right-8 top-1/2 -translate-y-1/2 hidden lg:flex w-28 h-28 rounded-full bg-white/10 items-center justify-center">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-14 h-14 text-white/80"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 21s8-4.5 8-10.5A4.5 4.5 0 0012 7a4.5 4.5 0 00-8 3.5C4 16.5 12 21 12 21z"
                        />
                    </svg>

                </div>

            </div>



            <!-- =================================================
                 QUICK ACTIONS
            ================================================== -->

            <div class="mb-10">

                <div class="mb-5">

                    <p class="text-sm text-slate-400">
                        Quick access
                    </p>

                    <h3 class="text-xl font-semibold mt-1">
                        Your Healthcare
                    </h3>

                </div>


                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">


                    <!-- APPOINTMENTS -->

                    <a
                        href="http://localhost:8052"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-300 hover:shadow-md transition"
                    >

                        <div
                            class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:scale-105 transition"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <rect
                                    x="3"
                                    y="4.5"
                                    width="18"
                                    height="16"
                                    rx="2"
                                />

                                <path
                                    stroke-linecap="round"
                                    d="M16 2.5v4M8 2.5v4M3 9h18"
                                />

                            </svg>

                        </div>

                        <h3 class="font-semibold text-lg">
                            Appointments
                        </h3>

                        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                            Book a new appointment or manage your upcoming
                            consultations.
                        </p>

                        <div
                            class="mt-5 text-sm font-medium text-emerald-600 group-hover:text-emerald-700"
                        >
                            Open Appointments →
                        </div>

                    </a>



                    <!-- PRESCRIPTIONS -->

                    <a
                        href="/prescriptions/patient"
                        class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-300 hover:shadow-md transition"
                    >

                        <div
                            class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-105 transition"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M7 3h7l4 4v14H7a2 2 0 01-2-2V5a2 2 0 012-2z"
                                />

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M14 3v5h5"
                                />

                                <path
                                    stroke-linecap="round"
                                    d="M9 13h6M9 17h4"
                                />

                            </svg>

                        </div>

                        <h3 class="font-semibold text-lg">
                            Prescriptions
                        </h3>

                        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                            View prescriptions issued by your doctors and
                            download them as images.
                        </p>

                        <div
                            class="mt-5 text-sm font-medium text-emerald-600 group-hover:text-emerald-700"
                        >
                            View Prescriptions →
                        </div>

                    </a>



                    <!-- MEDICAL RECORDS -->

                    <a
                        href="/medical-records"
                        class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-300 hover:shadow-md transition"
                    >

                        <div
                            class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-5 group-hover:scale-105 transition"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 3h9l4 4v14H6a2 2 0 01-2-2V5a2 2 0 012-2z"
                                />

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M15 3v5h5"
                                />

                                <path
                                    stroke-linecap="round"
                                    d="M8 13h8M8 17h6"
                                />

                            </svg>

                        </div>

                        <h3 class="font-semibold text-lg">
                            Medical Records
                        </h3>

                        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                            Access your medical documents, reports and
                            healthcare records.
                        </p>

                        <div
                            class="mt-5 text-sm font-medium text-emerald-600 group-hover:text-emerald-700"
                        >
                            Open Medical Records →
                        </div>

                    </a>



                    <!-- AI ASSISTANT -->

                    <a
                        href="http://localhost:8501"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-300 hover:shadow-md transition"
                    >

                        <div
                            class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-5 group-hover:scale-105 transition"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.8"
                            >
                                <rect
                                    x="4"
                                    y="5"
                                    width="16"
                                    height="13"
                                    rx="3"
                                />

                                <path
                                    stroke-linecap="round"
                                    d="M8 21h8M12 18v3"
                                />

                                <circle cx="9" cy="11" r="1" />
                                <circle cx="15" cy="11" r="1" />

                                <path
                                    stroke-linecap="round"
                                    d="M9 14h6"
                                />

                            </svg>

                        </div>

                        <h3 class="font-semibold text-lg">
                            AI Assistant
                        </h3>

                        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                            Talk with the HopeLeaf AI assistant and use
                            intelligent image analysis.
                        </p>

                        <div
                            class="mt-5 text-sm font-medium text-emerald-600 group-hover:text-emerald-700"
                        >
                            Open AI Assistant →
                        </div>

                    </a>

                </div>

            </div>



            <!-- =================================================
                 APPOINTMENTS SECTION
            ================================================== -->

            <div class="mt-10">

                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">

                    <div>

                        <p class="text-sm text-slate-400">
                            Your schedule
                        </p>

                        <h3 class="text-xl font-semibold mt-1">
                            Upcoming Appointments
                        </h3>

                    </div>


                    <a
                        href="http://localhost:8052"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-emerald-50 text-emerald-700 text-sm font-medium hover:bg-emerald-100 transition"
                    >
                        Book Appointment →
                    </a>

                </div>



                <!-- NO APPOINTMENTS -->

                <% if (!appointments || appointments.length === 0) { %>

                    <div
                        class="bg-white border border-slate-200 rounded-2xl p-10 text-center"
                    >

                        <div
                            class="w-14 h-14 mx-auto rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center mb-4"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-7 h-7"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.7"
                            >
                                <rect
                                    x="3"
                                    y="4.5"
                                    width="18"
                                    height="16"
                                    rx="2"
                                />

                                <path
                                    stroke-linecap="round"
                                    d="M16 2.5v4M8 2.5v4M3 9h18"
                                />

                            </svg>

                        </div>

                        <h4 class="font-semibold text-lg">
                            No upcoming appointments
                        </h4>

                        <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto">
                            You don't have any scheduled appointments yet.
                            When you book one, it will appear here.
                        </p>

                        <a
                            href="http://localhost:8052"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex mt-5 px-5 py-2.5 rounded-xl bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition"
                        >
                            Book an Appointment
                        </a>

                    </div>


                <% } else { %>


                    <!-- APPOINTMENT LIST -->

                    <div class="space-y-4">

                        <% appointments.forEach(function(appointment) { %>

                            <div
                                class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 hover:border-emerald-200 hover:shadow-sm transition"
                            >

                                <div
                                    class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5"
                                >


                                    <!-- DOCTOR -->

                                    <div class="min-w-0">

                                        <p
                                            class="text-xs text-slate-400 uppercase tracking-wide"
                                        >
                                            Doctor
                                        </p>

                                        <h4 class="font-semibold text-lg mt-1 truncate">

                                            Dr.

                                            <%= appointment.doctor_name || "Doctor" %>

                                        </h4>

                                        <% if (appointment.doctor_email) { %>

                                            <p
                                                class="text-sm text-slate-500 mt-1 truncate"
                                            >
                                                <%= appointment.doctor_email %>
                                            </p>

                                        <% } %>

                                    </div>



                                    <!-- DATE AND TIME -->

                                    <div class="flex gap-8">

                                        <div>

                                            <p
                                                class="text-xs text-slate-400 uppercase tracking-wide"
                                            >
                                                Date
                                            </p>

                                            <p class="text-sm font-medium mt-1">
                                                <%= appointment.date || "-" %>
                                            </p>

                                        </div>


                                        <div>

                                            <p
                                                class="text-xs text-slate-400 uppercase tracking-wide"
                                            >
                                                Time
                                            </p>

                                            <p class="text-sm font-medium mt-1">
                                                <%= appointment.time || "-" %>
                                            </p>

                                        </div>

                                    </div>



                                    <!-- STATUS -->

                                    <div>

                                        <% if (appointment.status === "scheduled") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700"
                                            >

                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>

                                                Scheduled

                                            </span>


                                        <% } else if (appointment.status === "completed") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700"
                                            >

                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>

                                                Completed

                                            </span>


                                        <% } else if (appointment.status === "cancelled") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-red-50 text-red-700"
                                            >

                                                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>

                                                Cancelled

                                            </span>


                                        <% } else { %>

                                            <span
                                                class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600"
                                            >
                                                <%= appointment.status || "Unknown" %>
                                            </span>

                                        <% } %>

                                    </div>

                                </div>



                                <!-- REASON -->

                                <% if (appointment.reason) { %>

                                    <div
                                        class="mt-5 pt-4 border-t border-slate-100"
                                    >

                                        <p
                                            class="text-xs text-slate-400 uppercase tracking-wide"
                                        >
                                            Reason for Visit
                                        </p>

                                        <p
                                            class="text-sm text-slate-600 mt-2 leading-relaxed"
                                        >
                                            <%= appointment.reason %>
                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        <% }) %>

                    </div>

                <% } %>

            </div>



            <!-- =================================================
                 PRESCRIPTION SHORTCUT
            ================================================== -->

            <div
                class="mt-10 bg-white border border-slate-200 rounded-2xl p-6 md:p-7"
            >

                <div
                    class="flex flex-col md:flex-row md:items-center md:justify-between gap-5"
                >

                    <div class="flex items-start gap-4">

                        <div
                            class="w-12 h-12 flex-shrink-0 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center"
                        >

                            <svg
