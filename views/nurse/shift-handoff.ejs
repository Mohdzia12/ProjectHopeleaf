
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Shift Handoff | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
        }

        .patient-card input:checked + .patient-content {
            border-color: rgb(16 185 129);
            background-color: rgb(236 253 245);
        }

        .patient-card input:checked + .patient-content .patient-icon {
            background-color: rgb(16 185 129);
            color: white;
        }
    </style>
</head>


<body class="bg-slate-50 text-slate-800">


    <!-- ====================================================== -->
    <!-- TOP NAVIGATION -->
    <!-- ====================================================== -->

    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">

        <div class="max-w-7xl mx-auto px-6">

            <div class="h-20 flex items-center justify-between">

                <!-- BRAND -->

                <a
                    href="/nurse/dashboard"
                    class="flex items-center gap-3"
                >

                    <div
                        class="w-11 h-11 rounded-2xl bg-emerald-100
                               flex items-center justify-center"
                    >

                        <i
                            data-lucide="leaf"
                            class="w-6 h-6 text-emerald-600"
                        ></i>

                    </div>

                    <div>

                        <h1 class="text-lg font-bold text-slate-900">
                            HopeLeaf
                        </h1>

                        <p class="text-xs text-slate-500">
                            Nursing Workspace
                        </p>

                    </div>

                </a>


                <!-- USER -->

                <div class="flex items-center gap-4">

                    <div class="hidden sm:block text-right">

                        <p class="text-sm font-semibold text-slate-900">
                            <%= user.name %>
                        </p>

                        <p class="text-xs text-slate-500">
                            Nurse
                        </p>

                    </div>


                    <div
                        class="w-10 h-10 rounded-full bg-emerald-100
                               flex items-center justify-center"
                    >

                        <span class="text-sm font-bold text-emerald-700">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : "N" %>
                        </span>

                    </div>


                    <a
                        href="/auth/logout"
                        class="hidden sm:flex items-center gap-2
                               px-4 py-2 rounded-xl
                               text-sm font-medium text-slate-600
                               hover:bg-slate-100 transition"
                    >

                        <i
                            data-lucide="log-out"
                            class="w-4 h-4"
                        ></i>

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </header>



    <!-- ====================================================== -->
    <!-- MAIN -->
    <!-- ====================================================== -->

    <main class="max-w-6xl mx-auto px-6 py-8">


        <!-- BACK NAVIGATION -->

        <div class="mb-6">

            <a
                href="/nurse/dashboard"
                class="inline-flex items-center gap-2
                       text-sm font-medium text-slate-500
                       hover:text-emerald-600 transition"
            >

                <i
                    data-lucide="arrow-left"
                    class="w-4 h-4"
                ></i>

                Back to Dashboard

            </a>

        </div>



        <!-- ================================================== -->
        <!-- PAGE HEADER -->
        <!-- ================================================== -->

        <section class="mb-8">

            <div class="flex flex-col md:flex-row
                        md:items-center md:justify-between gap-5">

                <div>

                    <div class="flex items-center gap-3 mb-3">

                        <div
                            class="w-12 h-12 rounded-2xl bg-blue-100
                                   flex items-center justify-center"
                        >

                            <i
                                data-lucide="send"
                                class="w-6 h-6 text-blue-600"
                            ></i>

                        </div>

                        <div>

                            <p class="text-sm font-semibold text-blue-600">
                                Shift Communication
                            </p>

                            <h2 class="text-3xl font-bold text-slate-900">
                                Shift Handoff
                            </h2>

                        </div>

                    </div>


                    <p class="text-slate-500 max-w-2xl">
                        Transfer important patient information to the nurse
                        taking over the next shift.
                    </p>

                </div>


                <!-- INCOMING HANDOFF -->

                <a
                    href="/nurse/incoming-handoffs"
                    class="inline-flex items-center justify-center gap-2
                           px-5 py-3 rounded-xl
                           bg-white border border-slate-200
                           text-sm font-semibold text-slate-700
                           shadow-sm hover:bg-slate-50 transition"
                >

                    <i
                        data-lucide="inbox"
                        class="w-4 h-4"
                    ></i>

                    Incoming Handoffs

                </a>

            </div>

        </section>



        <!-- ================================================== -->
        <!-- SUCCESS MESSAGE -->
        <!-- ================================================== -->

        <% if (sent) { %>

            <div
                class="mb-6 rounded-2xl border border-emerald-200
                       bg-emerald-50 px-5 py-4"
            >

                <div class="flex items-start gap-3">

                    <div
                        class="w-9 h-9 rounded-xl bg-emerald-100
                               flex items-center justify-center
                               flex-shrink-0"
                    >

                        <i
                            data-lucide="circle-check"
                            class="w-5 h-5 text-emerald-600"
                        ></i>

                    </div>

                    <div>

                        <p class="font-semibold text-emerald-800">
                            Handoff sent successfully
                        </p>

                        <p class="text-sm text-emerald-700 mt-1">
                            The receiving nurse can now view the handoff
                            from their Incoming Handoffs page.
                        </p>

                    </div>

                </div>

            </div>

        <% } %>



        <!-- ================================================== -->
        <!-- FORM -->
        <!-- ================================================== -->

        <form
            action="/nurse/handoff"
            method="POST"
            id="handoffForm"
        >


            <!-- ================================================= -->
            <!-- RECEIVING NURSE -->
            <!-- ================================================= -->

            <section
                class="bg-white rounded-2xl border border-slate-200
                       shadow-sm mb-6 overflow-hidden"
            >

                <div
                    class="px-6 py-5 border-b border-slate-200
                           bg-slate-50/70"
                >

                    <div class="flex items-center gap-3">

                        <div
                            class="w-10 h-10 rounded-xl bg-purple-100
                                   flex items-center justify-center"
                        >

                            <i
                                data-lucide="user-round-check"
                                class="w-5 h-5 text-purple-600"
                            ></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-900">
                                Receiving Nurse
                            </h3>

                            <p class="text-sm text-slate-500">
                                Choose who will take over these patients.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="p-6">

                    <label
                        for="receiving_nurse_id"
                        class="block text-sm font-semibold text-slate-700 mb-2"
                    >
                        Select Nurse
                    </label>


                    <select
                        id="receiving_nurse_id"
                        name="receiving_nurse_id"
                        required
                        class="w-full rounded-xl border border-slate-300
                               bg-white px-4 py-3.5 text-sm text-slate-800
                               focus:outline-none focus:ring-2
                               focus:ring-emerald-500
                               focus:border-emerald-500"
                    >

                        <option value="">
                            Select receiving nurse
                        </option>


                        <% if (nurses && nurses.length) { %>

                            <% nurses.forEach(nurse => { %>

                                <option value="<%= nurse._id %>">

                                    <%= nurse.name %>

                                    <% if (nurse.email) { %>
                                        - <%= nurse.email %>
                                    <% } %>

                                </option>

                            <% }) %>

                        <% } else { %>

                            <option value="" disabled>
                                No other nurses available
                            </option>

                        <% } %>

                    </select>


                    <div
                        class="mt-3 flex items-center gap-2
                               text-xs text-slate-400"
                    >

                        <i
                            data-lucide="info"
                            class="w-4 h-4"
                        ></i>

                        The selected nurse will receive this handoff.

                    </div>

                </div>

            </section>



            <!-- ================================================= -->
            <!-- PATIENT SELECTION -->
            <!-- ================================================= -->

            <section
                class="bg-white rounded-2xl border border-slate-200
                       shadow-sm mb-6 overflow-hidden"
            >

                <div
                    class="px-6 py-5 border-b border-slate-200
                           bg-slate-50/70"
                >

                    <div
                        class="flex flex-col sm:flex-row
                               sm:items-center sm:justify-between gap-4"
                    >

                        <div class="flex items-center gap-3">

                            <div
                                class="w-10 h-10 rounded-xl bg-emerald-100
                                       flex items-center justify-center"
                            >

                                <i
                                    data-lucide="users"
                                    class="w-5 h-5 text-emerald-600"
                                ></i>

                            </div>

                            <div>

                                <h3 class="font-bold text-slate-900">
                                    Patients
                                </h3>

                                <p class="text-sm text-slate-500">
                                    Select one or more patients to hand over.
                                </p>

                            </div>

                        </div>


                        <!-- SELECTED COUNT -->

                        <div
                            class="px-3 py-2 rounded-xl bg-emerald-50
                                   text-emerald-700 text-sm font-semibold"
                        >

                            <span id="selectedCount">
                                0
                            </span>

                            selected

                        </div>

                    </div>

                </div>



                <div class="p-6">


                    <!-- PATIENT CONTROLS -->

                    <div
                        class="flex flex-wrap items-center justify-between
                               gap-3 mb-5"
                    >

                        <p class="text-sm text-slate-500">
                            Choose the patients requiring handoff.
                        </p>


                        <div class="flex items-center gap-2">

                            <button
                                type="button"
                                id="selectAll"
                                class="px-3 py-2 rounded-lg
                                       text-xs font-semibold
                                       text-emerald-700
                                       bg-emerald-50
                                       hover:bg-emerald-100 transition"
                            >
                                Select All
                            </button>

                            <button
                                type="button"
                                id="clearAll"
                                class="px-3 py-2 rounded-lg
                                       text-xs font-semibold
                                       text-slate-600
                                       bg-slate-100
                                       hover:bg-slate-200 transition"
                            >
                                Clear All
                            </button>

                        </div>

                    </div>



                    <!-- PATIENT LIST -->

                    <% if (patients && patients.length) { %>

                        <div
                            class="grid grid-cols-1 md:grid-cols-2
                                   gap-3"
                        >

                            <% patients.forEach(patient => { %>

                                <label
                                    class="patient-card block cursor-pointer"
                                >

                                    <input
                                        type="checkbox"
                                        name="patient_ids"
                                        value="<%= patient._id %>"
                                        class="sr-only patient-checkbox"
                                    >


                                    <div
                                        class="patient-content flex items-center
                                               gap-4 p-4 rounded-xl
                                               border border-slate-200
                                               hover:border-emerald-300
                                               hover:bg-slate-50
                                               transition"
                                    >

                                        <div
                                            class="patient-icon w-11 h-11
                                                   rounded-xl bg-slate-100
                                                   text-slate-500
                                                   flex items-center
                                                   justify-center
                                                   flex-shrink-0 transition"
                                        >

                                            <i
                                                data-lucide="user"
                                                class="w-5 h-5"
                                            ></i>

                                        </div>


                                        <div class="min-w-0 flex-1">

                                            <p
                                                class="font-semibold
                                                       text-slate-900 truncate"
                                            >
                                                <%= patient.name %>
                                            </p>


                                            <% if (patient.email) { %>

                                                <p
                                                    class="text-xs text-slate-500
                                                           truncate mt-1"
                                                >
                                                    <%= patient.email %>
                                                </p>

                                            <% } else { %>

                                                <p
                                                    class="text-xs text-slate-400
                                                           mt-1"
                                                >
                                                    Patient record
                                                </p>

                                            <% } %>

                                        </div>


                                        <div
                                            class="selection-check
                                                   w-6 h-6 rounded-full
                                                   border-2 border-slate-300
                                                   flex items-center
                                                   justify-center
                                                   flex-shrink-0"
                                        >

                                            <i
                                                data-lucide="check"
                                                class="w-3.5 h-3.5
                                                       text-white hidden"
                                            ></i>

                                        </div>

                                    </div>

                                </label>

                            <% }) %>

                        </div>


                    <% } else { %>


                        <!-- EMPTY PATIENT STATE -->

                        <div
                            class="rounded-2xl border border-dashed
                                   border-slate-300 bg-slate-50
                                   p-10 text-center"
                        >

                            <div
                                class="w-14 h-14 mx-auto rounded-2xl
                                       bg-slate-100 flex items-center
                                       justify-center mb-4"
                            >

                                <i
                                    data-lucide="user-x"
                                    class="w-7 h-7 text-slate-400"
                                ></i>

                            </div>

                            <h4
                                class="font-semibold text-slate-800"
                            >
                                No patients available
                            </h4>

                            <p
                                class="text-sm text-slate-500 mt-1"
                            >
                                There are currently no patient records
                                available for handoff.
                            </p>

                        </div>

                    <% } %>

                </div>

            </section>



            <!-- ================================================= -->
            <!-- HANDOFF NOTES -->
            <!-- ================================================= -->

            <section
                class="bg-white rounded-2xl border border-slate-200
                       shadow-sm mb-6 overflow-hidden"
            >

                <div
                    class="px-6 py-5 border-b border-slate-200
                           bg-slate-50/70"
                >

                    <div class="flex items-center gap-3">

                        <div
                            class="w-10 h-10 rounded-xl bg-amber-100
                                   flex items-center justify-center"
                        >

                            <i
                                data-lucide="clipboard-list"
                                class="w-5 h-5 text-amber-600"
                            ></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-900">
                                Handoff Notes
                            </h3>

                            <p class="text-sm text-slate-500">
                                Share important information with the incoming nurse.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="p-6">

                    <label
                        for="handoff_notes"
                        class="block text-sm font-semibold text-slate-700 mb-2"
                    >
                        Clinical Handoff Notes
                    </label>


                    <textarea
                        id="handoff_notes"
                        name="handoff_notes"
                        rows="8"
                        required
                        placeholder="Example:

Patient stable during current shift.
Continue monitoring vital signs every 4 hours.
Medication scheduled for 10 PM.
Patient reported mild discomfort.
Follow up on pending laboratory results."
                        class="w-full rounded-xl border border-slate-300
                               px-4 py-3.5 text-sm text-slate-800
                               placeholder:text-slate-400
                               resize-y
                               focus:outline-none
                               focus:ring-2 focus:ring-emerald-500
                               focus:border-emerald-500"
                    ></textarea>


                    <div
                        class="mt-3 flex items-start gap-2
                               text-xs text-slate-400"
                    >

                        <i
                            data-lucide="info"
                            class="w-4 h-4 flex-shrink-0 mt-0.5"
                        ></i>

                        <p>
                            Include relevant observations, pending tasks,
                            medications, monitoring requirements, and
                            important patient concerns.
                        </p>

                    </div>

                </div>

            </section>



            <!-- ================================================= -->
            <!-- SUBMISSION AREA -->
            <!-- ================================================= -->

            <section
                class="bg-slate-900 rounded-2xl p-6 shadow-lg"
            >

                <div
                    class="flex flex-col md:flex-row
                           md:items-center md:justify-between gap-5"
                >

                    <div>

                        <div class="flex items-center gap-2 mb-2">

                            <i
                                data-lucide="shield-check"
                                class="w-5 h-5 text-emerald-400"
                            ></i>

                            <p
                                class="text-sm font-semibold
                                       text-white"
                            >
                                Secure Shift Communication
                            </p>

                        </div>

                        <p class="text-sm text-slate-400 max-w-xl">
                            The handoff will be securely stored in HopeLeaf
                            and made available to the selected receiving nurse.
                        </p>

                    </div>


                    <button
                        type="submit"
                        id="submitButton"
                        class="inline-flex items-center justify-center
                               gap-2 px-6 py-3.5 rounded-xl
                               bg-emerald-500 text-white
                               text-sm font-bold
                               hover:bg-emerald-600
                               transition shadow-sm"
                    >

                        <i
                            data-lucide="send"
                            class="w-4 h-4"
                        ></i>

                        Send Handoff

                    </button>

                </div>

            </section>

        </form>


        <!-- ================================================== -->
        <!-- FOOTER NAV -->
        <!-- ================================================== -->

        <div
            class="mt-8 flex flex-col sm:flex-row
                   items-center justify-between gap-4"
        >

            <a
                href="/nurse/dashboard"
                class="inline-flex items-center gap-2
                       text-sm font-medium text-slate-500
                       hover:text-emerald-600"
            >

                <i
                    data-lucide="layout-dashboard"
                    class="w-4 h-4"
                ></i>

                Nurse Dashboard

            </a>


            <a
                href="/nurse/incoming-handoffs"
                class="inline-flex items-center gap-2
                       text-sm font-medium text-slate-500
                       hover:text-emerald-600"
            >

                View Incoming Handoffs

                <i
                    data-lucide="arrow-right"
                    class="w-4 h-4"
                ></i>

            </a>

        </div>

    </main>



    <!-- ====================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ====================================================== -->

    <script>

        lucide.createIcons();


        const checkboxes = document.querySelectorAll(".patient-checkbox");

        const selectedCount =
            document.getElementById("selectedCount");

        const selectAll =
            document.getElementById("selectAll");

        const clearAll =
            document.getElementById("clearAll");

        const form =
            document.getElementById("handoffForm");

        const submitButton =
            document.getElementById("submitButton");


        function updatePatientSelection() {

            let count = 0;

            checkboxes.forEach((checkbox) => {

                const card =
                    checkbox.nextElementSibling;

                const checkIcon =
                    card.querySelector(".selection-check i");


                if (checkbox.checked) {

                    count++;

                    card.classList.add(
                        "ring-2",
                        "ring-emerald-100"
                    );

                    checkIcon.classList.remove("hidden");

                } else {

                    card.classList.remove(
                        "ring-2",
                        "ring-emerald-100"
                    );

                    checkIcon.classList.add("hidden");

                }

            });


            selectedCount.textContent = count;

        }


        checkboxes.forEach((checkbox) => {

            checkbox.addEventListener(
                "change",
                updatePatientSelection
            );

        });


        selectAll.addEventListener("click", () => {

            checkboxes.forEach((checkbox) => {

                checkbox.checked = true;

            });

            updatePatientSelection();

        });


        clearAll.addEventListener("click", () => {

            checkboxes.forEach((checkbox) => {

                checkbox.checked = false;

            });

            updatePatientSelection();

        });


        form.addEventListener("submit", (event) => {

            const receivingNurse =
                document.getElementById(
                    "receiving_nurse_id"
                ).value;

            const selectedPatients =
                document.querySelectorAll(
                    ".patient-checkbox:checked"
                );


            if (!receivingNurse) {

                event.preventDefault();

                alert(
                    "Please select a receiving nurse."
                );

                return;

            }


            if (selectedPatients.length === 0) {

                event.preventDefault();

                alert(
                    "Please select at least one patient."
                );

                return;

            }


            submitButton.disabled = true;

            submitButton.classList.add(
                "opacity-70",
                "cursor-not-allowed"
            );

            submitButton.innerHTML = `
                <i data-lucide="loader-circle"
                   class="w-4 h-4 animate-spin"></i>
                Sending Handoff...
            `;

            lucide.createIcons();

        });


        updatePatientSelection();

    </script>

</body>

</html>

