<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HopeLeaf | Nurse Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hope: {
                            50: "#f0fdfa",
                            100: "#ccfbf1",
                            500: "#14b8a6",
                            600: "#0d9488",
                            700: "#0f766e",
                            800: "#115e59"
                        }
                    }
                }
            }
        };
    </script>
</head>

<body class="bg-slate-50 text-slate-800">

    <%
        const formatDate = (dateValue) => {
            if (!dateValue) return "Not available";

            const date = new Date(dateValue);

            if (isNaN(date.getTime())) {
                return "Not available";
            }

            return date.toLocaleDateString("en-IN", {
                day: "2-digit",
                month: "short",
                year: "numeric"
            });
        };

        const formatDateTime = (dateValue) => {
            if (!dateValue) return "Not available";

            const date = new Date(dateValue);

            if (isNaN(date.getTime())) {
                return "Not available";
            }

            return date.toLocaleString("en-IN", {
                day: "2-digit",
                month: "short",
                hour: "2-digit",
                minute: "2-digit"
            });
        };

        const priorityClass = (priority) => {
            if (priority === "urgent") {
                return "bg-red-50 text-red-700 border-red-200";
            }

            if (priority === "high") {
                return "bg-orange-50 text-orange-700 border-orange-200";
            }

            if (priority === "low") {
                return "bg-slate-50 text-slate-600 border-slate-200";
            }

            return "bg-blue-50 text-blue-700 border-blue-200";
        };
    %>

    <!-- Top Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6">

            <div class="h-16 flex items-center justify-between">

                <!-- Logo -->
                <a href="/nurse/dashboard" class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-teal-600 flex items-center justify-center shadow-sm">
                        <svg
                            class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 5v14M5 12h14"
                            />
                        </svg>
                    </div>

                    <div>
                        <div class="font-bold text-lg text-slate-900 leading-tight">
                            HopeLeaf
                        </div>

                        <div class="text-xs text-slate-500">
                            Nursing Portal
                        </div>
                    </div>

                </a>

                <!-- Navigation -->
                <nav class="hidden lg:flex items-center gap-1">

                    <a
                        href="/nurse/dashboard"
                        class="px-4 py-2 rounded-lg bg-teal-50 text-teal-700 font-medium text-sm"
                    >
                        Dashboard
                    </a>

                    <a
                        href="/nurse/patients"
                        class="px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100 text-sm font-medium"
                    >
                        Patients
                    </a>

                    <a
                        href="/nurse/patient-logs"
                        class="px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100 text-sm font-medium"
                    >
                        Patient Logs
                    </a>

                    <a
                        href="/nurse/incoming-handoffs"
                        class="px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100 text-sm font-medium"
                    >
                        Handoffs
                    </a>

                </nav>

                <!-- User -->
                <div class="flex items-center gap-4">

                    <div class="hidden sm:block text-right">
                        <p class="text-sm font-semibold text-slate-800">
                            <%= user.name %>
                        </p>

                        <p class="text-xs text-slate-500">
                            Nurse
                        </p>
                    </div>

                    <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center font-semibold">
                        <%= user.name ? user.name.charAt(0).toUpperCase() : "N" %>
                    </div>

                    <a
                        href="/auth/logout"
                        class="hidden sm:flex items-center gap-2 text-sm text-slate-500 hover:text-red-600"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15 12H3m0 0l4-4m-4 4l4 4M21 5v14a2 2 0 01-2 2h-6"
                            />
                        </svg>

                        Logout
                    </a>

                </div>

            </div>

        </div>
    </header>


    <!-- Main -->
    <main class="max-w-7xl mx-auto px-6 py-8">

        <!-- Welcome -->
        <section class="mb-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>
                    <p class="text-sm font-medium text-teal-600 mb-1">
                        Nursing workspace
                    </p>

                    <h1 class="text-3xl font-bold text-slate-900">
                        Welcome, <%= user.name %>
                    </h1>

                    <p class="text-slate-500 mt-2">
                        Manage patient observations, clinical logs and shift handoffs.
                    </p>
                </div>

                <a
                    href="/nurse/patient-log/new"
                    class="inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-5 py-3 rounded-xl shadow-sm transition"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="1.8"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 5v14M5 12h14"
                        />
                    </svg>

                    Create Patient Log
                </a>

            </div>

        </section>


        <!-- Stats -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">

            <!-- Patients -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">

                <div class="flex items-start justify-between">

                    <div>
                        <p class="text-sm text-slate-500">
                            Total Patients
                        </p>

                        <p class="text-3xl font-bold text-slate-900 mt-2">
                            <%= totalPatients || 0 %>
                        </p>
                    </div>

                    <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"
                            />

                            <circle
                                cx="9"
                                cy="7"
                                r="4"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
                            />
                        </svg>

                    </div>

                </div>

                <a
                    href="/nurse/patients"
                    class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-700 mt-4 font-medium"
                >
                    View patients

                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                        />
                    </svg>
                </a>

            </div>


            <!-- Doctors -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">

                <div class="flex items-start justify-between">

                    <div>
                        <p class="text-sm text-slate-500">
                            Doctors
                        </p>

                        <p class="text-3xl font-bold text-slate-900 mt-2">
                            <%= totalDoctors || 0 %>
                        </p>
                    </div>

                    <div class="w-11 h-11 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 14a5 5 0 100-10 5 5 0 000 10z"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4 21a8 8 0 0116 0"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 7v4M10 9h4"
                            />
                        </svg>

                    </div>

                </div>

                <p class="text-sm text-slate-500 mt-4">
                    Available care team
                </p>

            </div>


            <!-- Logs -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">

                <div class="flex items-start justify-between">

                    <div>
                        <p class="text-sm text-slate-500">
                            My Patient Logs
                        </p>

                        <p class="text-3xl font-bold text-slate-900 mt-2">
                            <%= myLogs || 0 %>
                        </p>
                    </div>

                    <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 5h6M9 9h6M9 13h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"
                            />
                        </svg>

                    </div>

                </div>

                <a
                    href="/nurse/patient-logs"
                    class="inline-flex items-center gap-1 text-sm text-indigo-600 hover:text-indigo-700 mt-4 font-medium"
                >
                    View logs

                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                        />
                    </svg>
                </a>

            </div>


            <!-- Handoffs -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">

                <div class="flex items-start justify-between">

                    <div>
                        <p class="text-sm text-slate-500">
                            Incoming Handoffs
                        </p>

                        <p class="text-3xl font-bold text-slate-900 mt-2">
                            <%= incomingHandoffs || 0 %>
                        </p>
                    </div>

                    <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M7 7h10M17 7l-3-3M17 7l-3 3M17 17H7M7 17l3-3M7 17l3 3"
                            />
                        </svg>

                    </div>

                </div>

                <a
                    href="/nurse/incoming-handoffs"
                    class="inline-flex items-center gap-1 text-sm text-orange-600 hover:text-orange-700 mt-4 font-medium"
                >
                    Review handoffs

                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                        />
                    </svg>
                </a>

            </div>

        </section>


        <!-- Quick Actions -->
        <section class="mb-8">

            <div class="flex items-center justify-between mb-4">

                <div>
                    <h2 class="text-xl font-bold text-slate-900">
                        Nursing Tools
                    </h2>

                    <p class="text-sm text-slate-500 mt-1">
                        Common tasks for your shift
                    </p>
                </div>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                <!-- Patient Log -->
                <a
                    href="/nurse/patient-log/new"
                    class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-teal-300 hover:shadow-md transition"
                >

                    <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center mb-5">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12h6M9 16h6M8 4h8a2 2 0 012 2v14H6V6a2 2 0 012-2z"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 4V2h6v2"
                            />
                        </svg>

                    </div>

                    <h3 class="font-semibold text-lg text-slate-900">
                        Patient Log
                    </h3>

                    <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                        Record observations, symptoms, vital notes and care updates.
                    </p>

                    <div class="mt-5 text-sm font-semibold text-teal-600 flex items-center gap-1">

                        Create log

                        <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                            />
                        </svg>

                    </div>

                </a>


                <!-- SBAR -->
                <a
                    href="/nurse/sbar"
                    class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-indigo-300 hover:shadow-md transition"
                >

                    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-5">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8 8h8M8 12h8M8 16h5"
                            />
                        </svg>

                    </div>

                    <h3 class="font-semibold text-lg text-slate-900">
                        SBAR Handoff
                    </h3>

                    <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                        Prepare a structured Situation, Background, Assessment and Recommendation handoff.
                    </p>

                    <div class="mt-5 text-sm font-semibold text-indigo-600 flex items-center gap-1">

                        Create SBAR

                        <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                            />
                        </svg>

                    </div>

                </a>


                <!-- Shift Handoff -->
                <a
                    href="/nurse/handoff"
                    class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-orange-300 hover:shadow-md transition"
                >

                    <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center mb-5">

                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8 7h12M8 12h12M8 17h12"
                            />

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4 7h.01M4 12h.01M4 17h.01"
                            />
                        </svg>

                    </div>

                    <h3 class="font-semibold text-lg text-slate-900">
                        Shift Handoff
                    </h3>

                    <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                        Transfer active patients and important notes to the incoming nurse.
                    </p>

                    <div class="mt-5 text-sm font-semibold text-orange-600 flex items-center gap-1">

                        Prepare handoff

                        <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                            />
                        </svg>

                    </div>

                </a>

            </div>

        </section>


        <!-- Two Column Content -->
        <section class="grid grid-cols-1 xl:grid-cols-2 gap-6">

            <!-- Recent Patient Logs -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

                <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between">

                    <div>
                        <h2 class="font-bold text-lg text-slate-900">
                            Recent Patient Logs
                        </h2>

                        <p class="text-sm text-slate-500 mt-1">
                            Your latest clinical updates
                        </p>
                    </div>

                    <a
                        href="/nurse/patient-logs"
                        class="text-sm font-medium text-teal-600 hover:text-teal-700"
                    >
                        View all
                    </a>

                </div>


                <% if (recentLogs && recentLogs.length > 0) { %>

                    <div class="divide-y divide-slate-100">

                        <% recentLogs.forEach(log => { %>

                            <a
                                href="/nurse/patient-log/<%= log._id %>"
                                class="block px-6 py-5 hover:bg-slate-50 transition"
                            >

                                <div class="flex items-start justify-between gap-4">

                                    <div class="min-w-0">

                                        <div class="flex items-center gap-2">

                                            <h3 class="font-semibold text-slate-900 truncate">
                                                <%= log.patient_name || "Unknown Patient" %>
                                            </h3>

                                            <span
                                                class="text-xs px-2 py-1 rounded-full border <%= priorityClass(log.priority) %>"
                                            >
                                                <%= log.priority || "normal" %>
                                            </span>

                                        </div>

                                        <p class="text-sm text-slate-500 mt-1">
                                            Assigned doctor:
                                            <span class="text-slate-700">
                                                <%= log.doctor_name || "Not assigned" %>
                                            </span>
                                        </p>

                                        <p class="text-xs text-slate-400 mt-2">
                                            Updated <%= formatDateTime(log.updated_at || log.created_at) %>
                                        </p>

                                    </div>

                                    <svg
                                        class="w-5 h-5 text-slate-400 flex-shrink-0 mt-1"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 5l7 7-7 7"
                                        />
                                    </svg>

                                </div>

                            </a>

                        <% }); %>

                    </div>

                <% } else { %>

                    <div class="px-6 py-12 text-center">

                        <div class="w-12 h-12 mx-auto rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center">

                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                stroke-width="1.8"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 12h6M9 16h4M8 4h8a2 2 0 012 2v14H6V6a2 2 0 012-2z"
                                />
                            </svg>

                        </div>

                        <h3 class="font-semibold text-slate-800 mt-4">
                            No patient logs yet
                        </h3>

                        <p class="text-sm text-slate-500 mt-1">
                            Your clinical logs will appear here.
                        </p>

                        <a
                            href="/nurse/patient-log/new"
                            class="inline-flex items-center gap-2 mt-5 text-sm font-semibold text-teal-600"
                        >
                            Create your first log
                        </a>

                    </div>

                <% } %>

            </div>


            <!-- Upcoming Appointments -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

                <div class="px-6 py-5 border-b border-slate-200">

                    <h2 class="font-bold text-lg text-slate-900">
                        Upcoming Appointments
                    </h2>

                    <p class="text-sm text-slate-500 mt-1">
                        Patients scheduled for care
                    </p>

                </div>


                <% if (upcomingAppointments && upcomingAppointments.length > 0) { %>

                    <div class="divide-y divide-slate-100">

                        <% upcomingAppointments.slice(0, 6).forEach(appointment => { %>

                            <div class="px-6 py-5">

                                <div class="flex items-center justify-between gap-4">

                                    <div class="flex items-center gap-3 min-w-0">

                                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">

                                            <svg
                                                class="w-5 h-5"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                                stroke-width="1.8"
                                            >
                                                <rect
                                                    x="3"
                                                    y="4"
                                                    width="18"
                                                    height="18"
                                                    rx="2"
                                                    ry="2"
                                                />

                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M16 2v4M8 2v4M3 10h18"
                                                />
                                            </svg>

                                        </div>

                                        <div class="min-w-0">

                                            <p class="font-semibold text-slate-900 truncate">
                                                <%= appointment.patient_name || appointment.patientName || "Unknown Patient" %>
                                            </p>

                                            <p class="text-sm text-slate-500 truncate">
                                                Dr. <%= appointment.doctor_name || "Unassigned" %>
                                            </p>

                                        </div>

                                    </div>


                                    <div class="text-right flex-shrink-0">

                                        <p class="text-sm font-semibold text-slate-800">
                                            <%= appointment.date || "Date not set" %>
                                        </p>

                                        <p class="text-xs text-slate-500 mt-1">
                                            <%= appointment.time || "Time not set" %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% }); %>

                    </div>

                <% } else { %>

                    <div class="px-6 py-12 text-center">

                        <div class="w-12 h-12 mx-auto rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center">

                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
