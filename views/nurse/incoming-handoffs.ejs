
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Incoming Handoffs | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-slate-50 text-slate-800">

    <!-- HEADER -->
    <header class="bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                    <i data-lucide="leaf" class="w-5 h-5 text-emerald-600"></i>
                </div>

                <div>
                    <h1 class="font-bold text-slate-900">
                        HopeLeaf
                    </h1>

                    <p class="text-xs text-slate-500">
                        Nurse Handoff Center
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-5">

                <div class="hidden sm:block text-right">
                    <p class="text-sm font-semibold text-slate-900">
                        <%= user.name %>
                    </p>

                    <p class="text-xs text-slate-500">
                        Nurse
                    </p>
                </div>

                <a
                    href="/auth/logout"
                    class="px-4 py-2 rounded-lg text-sm font-medium
                           text-slate-600 hover:bg-slate-100"
                >
                    Logout
                </a>

            </div>

        </div>
    </header>


    <!-- MAIN -->
    <main class="max-w-6xl mx-auto px-6 py-8">

        <!-- BACK -->
        <a
            href="/nurse/dashboard"
            class="inline-flex items-center gap-2 text-sm font-medium
                   text-slate-600 hover:text-emerald-600 mb-6"
        >
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Dashboard
        </a>


        <!-- HEADER -->
        <div class="mb-8">

            <div class="flex items-center gap-3 mb-2">

                <div class="w-11 h-11 rounded-xl bg-emerald-100
                            flex items-center justify-center">

                    <i data-lucide="inbox"
                       class="w-6 h-6 text-emerald-600"></i>

                </div>

                <h2 class="text-3xl font-bold text-slate-900">
                    Incoming Handoffs
                </h2>

            </div>

            <p class="text-slate-500">
                Review patient information handed over by other nurses.
            </p>

        </div>


        <!-- SUCCESS MESSAGE -->
        <% if (typeof success !== "undefined" && success) { %>

            <div class="mb-6 rounded-xl border border-emerald-200
                        bg-emerald-50 px-5 py-4 text-emerald-700">

                <div class="flex items-center gap-3">

                    <i data-lucide="circle-check" class="w-5 h-5"></i>

                    <p class="text-sm font-medium">
                        <%= success %>
                    </p>

                </div>

            </div>

        <% } %>


        <!-- SHIFT HANDOFFS -->
        <section class="mb-10">

            <div class="flex items-center justify-between mb-4">

                <div>
                    <h3 class="text-xl font-bold text-slate-900">
                        Shift Handoffs
                    </h3>

                    <p class="text-sm text-slate-500">
                        Patient information received from another nurse.
                    </p>
                </div>

                <span class="px-3 py-1 rounded-full bg-slate-100
                             text-slate-600 text-xs font-semibold">
                    <%= shiftHandoffs.length %> handoff<%= shiftHandoffs.length === 1 ? "" : "s" %>
                </span>

            </div>


            <% if (!shiftHandoffs.length) { %>

                <div class="bg-white border border-slate-200 rounded-2xl
                            p-10 text-center">

                    <div class="w-14 h-14 mx-auto rounded-2xl bg-slate-100
                                flex items-center justify-center mb-4">

                        <i data-lucide="inbox"
                           class="w-7 h-7 text-slate-400"></i>

                    </div>

                    <h4 class="font-semibold text-slate-900">
                        No incoming shift handoffs
                    </h4>

                    <p class="text-sm text-slate-500 mt-1">
                        New handoffs from other nurses will appear here.
                    </p>

                </div>

            <% } else { %>

                <div class="space-y-4">

                    <% shiftHandoffs.forEach(handoff => { %>

                        <div class="bg-white border border-slate-200
                                    rounded-2xl shadow-sm p-6">

                            <div class="flex flex-col md:flex-row
                                        md:items-start md:justify-between gap-5">

                                <div>

                                    <div class="flex items-center gap-3 mb-3">

                                        <div class="w-10 h-10 rounded-xl
                                                    bg-blue-100 flex items-center
                                                    justify-center">

                                            <i data-lucide="user-round"
                                               class="w-5 h-5 text-blue-600"></i>

                                        </div>

                                        <div>

                                            <h4 class="font-bold text-slate-900">
                                                <%= handoff.patient_names
                                                    ? handoff.patient_names.join(", ")
                                                    : handoff.patient_name || "Patient" %>
                                            </h4>

                                            <p class="text-xs text-slate-500">
                                                From <%= handoff.from_nurse_name || "Nurse" %>
                                            </p>

                                        </div>

                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">

                                        <div>
                                            <p class="text-xs text-slate-400 uppercase font-semibold">
                                                Handoff Notes
                                            </p>

                                            <p class="mt-1 text-slate-700 whitespace-pre-line">
                                                <%= handoff.notes || "No notes provided." %>
                                            </p>
                                        </div>

                                        <div>
                                            <p class="text-xs text-slate-400 uppercase font-semibold">
                                                Sent
                                            </p>

                                            <p class="mt-1 text-slate-700">
                                                <%= handoff.created_at
                                                    ? new Date(handoff.created_at).toLocaleString()
                                                    : "Not available" %>
                                            </p>
                                        </div>

                                    </div>

                                </div>


                                <div>

                                    <span class="inline-flex items-center gap-2
                                                 px-3 py-2 rounded-full
                                                 bg-emerald-100 text-emerald-700
                                                 text-xs font-semibold">

                                        <i data-lucide="arrow-down-to-line"
                                           class="w-4 h-4"></i>

                                        Received

                                    </span>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </section>


        <!-- SBAR HANDOFFS -->
        <section>

            <div class="flex items-center justify-between mb-4">

                <div>
                    <h3 class="text-xl font-bold text-slate-900">
                        SBAR Handoffs
                    </h3>

                    <p class="text-sm text-slate-500">
                        Structured clinical communication from nursing staff.
                    </p>
                </div>

                <span class="px-3 py-1 rounded-full bg-slate-100
                             text-slate-600 text-xs font-semibold">
                    <%= sbarHandoffs.length %> report<%= sbarHandoffs.length === 1 ? "" : "s" %>
                </span>

            </div>


            <% if (!sbarHandoffs.length) { %>

                <div class="bg-white border border-slate-200 rounded-2xl
                            p-10 text-center">

                    <div class="w-14 h-14 mx-auto rounded-2xl bg-slate-100
                                flex items-center justify-center mb-4">

                        <i data-lucide="clipboard-list"
                           class="w-7 h-7 text-slate-400"></i>

                    </div>

                    <h4 class="font-semibold text-slate-900">
                        No SBAR handoffs
                    </h4>

                    <p class="text-sm text-slate-500 mt-1">
                        Structured SBAR reports will appear here.
                    </p>

                </div>

            <% } else { %>

                <div class="space-y-4">

                    <% sbarHandoffs.forEach(handoff => { %>

                        <div class="bg-white border border-slate-200
                                    rounded-2xl shadow-sm p-6">

                            <div class="flex flex-col md:flex-row
                                        md:justify-between gap-5">

                                <div class="flex-1">

                                    <div class="flex items-center gap-3 mb-4">

                                        <div class="w-10 h-10 rounded-xl
                                                    bg-purple-100 flex items-center
                                                    justify-center">

                                            <i data-lucide="clipboard-list"
                                               class="w-5 h-5 text-purple-600"></i>

                                        </div>

                                        <div>

                                            <h4 class="font-bold text-slate-900">
                                                <%= handoff.patient_name || "Patient" %>
                                            </h4>

                                            <p class="text-xs text-slate-500">
                                                From <%= handoff.from_nurse_name || "Nurse" %>
                                            </p>

                                        </div>

                                    </div>


                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                        <div>
                                            <p class="text-xs uppercase font-semibold text-slate-400">
                                                Situation
                                            </p>

                                            <p class="mt-1 text-sm text-slate-700 whitespace-pre-line">
                                                <%= handoff.situation || "Not provided." %>
                                            </p>
                                        </div>


                                        <div>
                                            <p class="text-xs uppercase font-semibold text-slate-400">
                                                Background
                                            </p>

                                            <p class="mt-1 text-sm text-slate-700 whitespace-pre-line">
                                                <%= handoff.background || "Not provided." %>
                                            </p>
                                        </div>


                                        <div>
                                            <p class="text-xs uppercase font-semibold text-slate-400">
                                                Assessment
                                            </p>

                                            <p class="mt-1 text-sm text-slate-700 whitespace-pre-line">
                                                <%= handoff.assessment || "Not provided." %>
                                            </p>
                                        </div>


                                        <div>
                                            <p class="text-xs uppercase font-semibold text-slate-400">
                                                Recommendation
                                            </p>

                                            <p class="mt-1 text-sm text-slate-700 whitespace-pre-line">
                                                <%= handoff.recommendation || "Not provided." %>
                                            </p>
                                        </div>

                                    </div>

                                </div>


                                <div>

                                    <span class="inline-flex items-center gap-2
                                                 px-3 py-2 rounded-full
                                                 bg-purple-100 text-purple-700
                                                 text-xs font-semibold">

                                        <i data-lucide="clipboard-check"
                                           class="w-4 h-4"></i>

                                        SBAR

                                    </span>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </section>

    </main>


    <script>
        lucide.createIcons();
    </script>

</body>
</html>

