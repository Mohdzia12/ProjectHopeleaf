
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Prescriptions | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header class="bg-white border-b border-slate-200">

        <div class="max-w-6xl mx-auto px-6 py-5">

            <div class="flex items-center justify-between">

                <div>
                    <h1 class="text-2xl font-bold text-emerald-600">
                        HopeLeaf
                    </h1>

                    <p class="text-sm text-slate-400 mt-1">
                        Prescription Portal
                    </p>
                </div>

                <a
                    href="/patient/dashboard"
                    class="text-sm text-slate-500 hover:text-emerald-600 transition"
                >
                    Patient Portal
                </a>

            </div>

        </div>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <main class="max-w-6xl mx-auto px-6 py-10">

        <% if (!patient) { %>

            <!-- ================================================= -->
            <!-- LOGIN -->
            <!-- ================================================= -->

            <div class="max-w-md mx-auto">

                <div class="text-center mb-8">

                    <div
                        class="w-16 h-16 mx-auto rounded-2xl bg-emerald-100 flex items-center justify-center text-3xl mb-5"
                    >
                        💊
                    </div>

                    <h2 class="text-3xl font-bold text-slate-800">
                        Access Your Prescriptions
                    </h2>

                    <p class="text-slate-500 mt-3">
                        Enter your patient account details to view
                        prescriptions uploaded by your doctor.
                    </p>

                </div>


                <!-- ERROR -->

                <% if (error) { %>

                    <div
                        class="mb-5 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm"
                    >
                        <%= error %>
                    </div>

                <% } %>


                <!-- LOGIN FORM -->

                <form
                    action="/prescriptions/patient"
                    method="POST"
                    class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm"
                >

                    <!-- EMAIL -->

                    <div class="mb-5">

                        <label
                            for="email"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        >
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            autocomplete="email"
                            placeholder="Enter your email"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                        >

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-6">

                        <label
                            for="password"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        >
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            autocomplete="current-password"
                            placeholder="Enter your password"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                        >

                    </div>


                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="w-full bg-emerald-600 text-white py-3 rounded-xl font-medium hover:bg-emerald-700 transition"
                    >
                        Access Prescriptions
                    </button>

                </form>

            </div>


        <% } else { %>


            <!-- ================================================= -->
            <!-- PATIENT HEADER -->
            <!-- ================================================= -->

            <div class="mb-8">

                <p class="text-sm text-slate-400">
                    Prescription Portal
                </p>

                <h2 class="text-3xl font-bold mt-1">
                    Welcome, <%= patient.name %>
                </h2>

                <p class="text-slate-500 mt-2">
                    <%= patient.email %>
                </p>

            </div>


            <!-- ================================================= -->
            <!-- PRESCRIPTIONS -->
            <!-- ================================================= -->

            <% if (!prescriptions || prescriptions.length === 0) { %>

                <!-- EMPTY -->

                <div
                    class="bg-white border border-slate-200 rounded-2xl p-10 text-center"
                >

                    <div class="text-4xl mb-4">
                        📄
                    </div>

                    <h3 class="text-xl font-semibold">
                        No prescriptions available
                    </h3>

                    <p class="text-slate-500 mt-2">
                        Prescriptions uploaded by your doctor will
                        appear here.
                    </p>

                </div>


            <% } else { %>


                <!-- ================================================= -->
                <!-- LIST -->
                <!-- ================================================= -->

                <div class="space-y-5">

                    <% prescriptions.forEach(function(prescription) { %>

                        <div
                            class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-emerald-300 transition"
                        >

                            <div
                                class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5"
                            >

                                <!-- FILE DETAILS -->

                                <div class="flex items-start gap-4">

                                    <div
                                        class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-2xl flex-shrink-0"
                                    >
                                        📄
                                    </div>


                                    <div class="min-w-0">

                                        <h3
                                            class="font-semibold text-lg break-words"
                                        >
                                            <%= prescription.original_filename %>
                                        </h3>


                                        <% if (prescription.description) { %>

                                            <p
                                                class="text-sm text-slate-500 mt-1"
                                            >
                                                <%= prescription.description %>
                                            </p>

                                        <% } %>


                                        <div
                                            class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-xs text-slate-400"
                                        >

                                            <span>
                                                Doctor:
                                                <%= prescription.doctor_name || "Doctor" %>
                                            </span>

                                            <span>
                                                Uploaded:
                                                <%= new Date(
                                                    prescription.uploaded_at
                                                ).toLocaleDateString() %>
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <!-- DOWNLOAD BUTTON -->

                                <div class="flex-shrink-0">

                                    <a
                                        href="/prescriptions/download/<%= encodeURIComponent(prescription.stored_filename) %>"
                                        download
                                        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition"
                                    >

                                        <span class="text-lg">
                                            ↓
                                        </span>

                                        Download Prescription

                                    </a>

                                </div>

                            </div>

                        </div>

                    <% }); %>

                </div>

            <% } %>


            <!-- ================================================= -->
            <!-- RETURN -->
            <!-- ================================================= -->

            <div class="mt-8">

                <a
                    href="/prescriptions/patient"
                    class="inline-flex items-center text-sm text-slate-500 hover:text-emerald-600 transition"
                >
                    ← Access another account
                </a>

            </div>


        <% } %>

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="border-t border-slate-200 mt-12">

        <div class="max-w-6xl mx-auto px-6 py-6 text-center">

            <p class="text-xs text-slate-400">
                HopeLeaf Prescription Portal
            </p>

        </div>

    </footer>

</body>

</html>

