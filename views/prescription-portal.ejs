<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

```
<title>Prescription Portal | HopeLeaf</title>

<script src="https://cdn.tailwindcss.com"></script>
```

</head>

<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen flex items-center justify-center px-4 py-10">

```
<div class="w-full max-w-md">

    <!-- HEADER -->
    <div class="text-center mb-8">

        <div class="inline-flex items-center justify-center
                    w-14 h-14 rounded-2xl
                    bg-emerald-100 text-emerald-600
                    text-2xl mb-4">
            📋
        </div>

        <h1 class="text-3xl font-bold text-slate-800">
            HopeLeaf
        </h1>

        <p class="text-sm text-slate-500 mt-2">
            Patient Prescription Portal
        </p>

    </div>


    <!-- LOGIN CARD -->
    <div class="bg-white border border-slate-200
                rounded-2xl shadow-sm p-6 md:p-8">

        <div class="mb-6">

            <h2 class="text-xl font-semibold">
                Access Your Prescriptions
            </h2>

            <p class="text-sm text-slate-500 mt-2">
                Enter your HopeLeaf account email and password
                to view prescriptions uploaded by your doctor.
            </p>

        </div>


        <!-- ERROR -->
        <% if (typeof error !== 'undefined' && error) { %>

            <div class="mb-5 rounded-xl
                        bg-red-50 border border-red-200
                        px-4 py-3">

                <p class="text-sm text-red-700">
                    <%= error %>
                </p>

            </div>

        <% } %>


        <!-- LOGIN FORM -->
        <form
            action="/prescription-portal"
            method="POST"
            class="space-y-5"
        >

            <!-- EMAIL -->
            <div>

                <label
                    for="email"
                    class="block text-sm font-medium text-slate-700 mb-2"
                >
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="patient@example.com"
                    class="w-full px-4 py-3
                           rounded-xl
                           border border-slate-300
                           focus:outline-none
                           focus:ring-2
                           focus:ring-emerald-500
                           focus:border-emerald-500"
                >

            </div>


            <!-- PASSWORD -->
            <div>

                <label
                    for="password"
                    class="block text-sm font-medium text-slate-700 mb-2"
                >
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    required
                    autocomplete="current-password"
                    placeholder="Enter your password"
                    class="w-full px-4 py-3
                           rounded-xl
                           border border-slate-300
                           focus:outline-none
                           focus:ring-2
                           focus:ring-emerald-500
                           focus:border-emerald-500"
                >

            </div>


            <!-- SUBMIT -->
            <button
                type="submit"
                class="w-full
                       bg-emerald-600
                       hover:bg-emerald-700
                       text-white
                       font-medium
                       py-3
                       rounded-xl
                       transition"
            >
                Access Prescriptions
            </button>

        </form>


        <!-- INFO -->
        <div class="mt-6 pt-6 border-t border-slate-100">

            <p class="text-xs text-slate-400 text-center">
                Your prescriptions are retrieved directly
                from the HopeLeaf database.
            </p>

        </div>

    </div>


    <!-- FOOTER -->
    <p class="text-center text-xs text-slate-400 mt-6">
        HopeLeaf Patient Portal
    </p>

</div>
```

</div>

</body>
</html>
