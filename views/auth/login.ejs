<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-slate-50 flex items-center justify-center">

    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm p-8">

        <div class="mb-8 text-center">

            <h1 class="text-3xl font-semibold text-slate-800">
                HopeLeaf
            </h1>

            <p class="mt-2 text-slate-500">
                Welcome back
            </p>

        </div>

        <form action="/auth/login" method="POST" class="space-y-5">

            <div>

                <label class="block text-sm font-medium text-slate-700 mb-2">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    placeholder="you@example.com"
                >

            </div>

            <div>

                <label class="block text-sm font-medium text-slate-700 mb-2">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    required
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    placeholder="Enter your password"
                >

            </div>

            <button
                type="submit"
                class="w-full py-3 bg-emerald-600 text-white rounded-xl font-medium hover:bg-emerald-700 transition"
            >
                Login
            </button>

        </form>

        <p class="text-center text-sm text-slate-500 mt-6">

            Don't have an account?

            <a
                href="/auth/register"
                class="text-emerald-600 font-medium"
            >
                Create one
            </a>

        </p>

    </div>

</body>
</html>