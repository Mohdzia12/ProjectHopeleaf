<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Patient Logs | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 text-slate-800">

<header class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

        <div>
            <h1 class="text-2xl font-bold text-slate-900">
                Patient Logs
            </h1>

            <p class="text-sm text-slate-500 mt-1">
                Patient information received from nursing staff
            </p>
        </div>

        <div class="flex gap-3">

            <a
                href="/doctor/dashboard"
                class="px-4 py-2 rounded-lg bg-slate-900 text-white text-sm font-medium hover:bg-slate-800"
            >
                Dashboard
            </a>

            <a
                href="/auth/logout"
                class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium hover:bg-slate-50"
            >
                Logout
            </a>

        </div>

    </div>
</header>


<main class="max-w-7xl mx-auto px-6 py-8">

    <% if (logs.length === 0) { %>

        <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center">

            <div class="mx-auto w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-7 h-7 text-slate-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a2 2 0 011.414.586l4.414 4.414A2 2 0 0119 9v10a2 2 0 01-2 2z"
                    />
                </svg>

            </div>

            <h2 class="mt-4 text-lg font-semibold text-slate-900">
                No patient logs yet
            </h2>

            <p class="mt-2 text-sm text-slate-500">
                Patient logs sent by nurses will appear here.
            </p>

        </div>

    <% } else { %>

        <div class="grid gap-5">

            <% logs.forEach(log => { %>

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                        <div>

                            <h2 class="text-lg font-semibold text-slate-900">
                                <%= log.patient_name || "Unknown Patient" %>
                            </h2>

                            <p class="text-sm text-slate-500 mt-1">
                                Sent by Nurse:
                                <span class="font-medium text-slate-700">
                                    <%= log.nurse_name || "Unknown Nurse" %>
                                </span>
                            </p>

                        </div>


                        <div class="flex items-center gap-3">

                            <span
                                class="px-3 py-1 rounded-full text-xs font-semibold
                                <%= log.priority === 'urgent'
                                    ? 'bg-red-100 text-red-700'
                                    : log.priority === 'high'
                                        ? 'bg-orange-100 text-orange-700'
                                        : 'bg-blue-100 text-blue-700'
                                %>"
                            >
                                <%= log.priority || "normal" %>
                            </span>

                            <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">
                                <%= log.status || "sent" %>
                            </span>

                        </div>

                    </div>


                    <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4">

                        <div class="bg-slate-50 rounded-lg p-4">

                            <p class="text-xs uppercase tracking-wide text-slate-400">
                                Symptoms
                            </p>

                            <p class="mt-2 text-sm text-slate-700">
                                <%= log.symptoms || "No symptoms recorded." %>
                            </p>

                        </div>


                        <div class="bg-slate-50 rounded-lg p-4">

                            <p class="text-xs uppercase tracking-wide text-slate-400">
                                Vital Notes
                            </p>

                            <p class="mt-2 text-sm text-slate-700">
                                <%= log.vital_notes || "No vital notes recorded." %>
                            </p>

                        </div>


                        <div class="bg-slate-50 rounded-lg p-4">

                            <p class="text-xs uppercase tracking-wide text-slate-400">
                                Created
                            </p>

                            <p class="mt-2 text-sm text-slate-700">
                                <%= log.created_at
                                    ? new Date(log.created_at).toLocaleString()
                                    : "Not available" %>
                            </p>

                        </div>

                    </div>


                    <div class="mt-5 flex justify-end">

                        <a
                            href="/doctor/patient-log/<%= log._id %>"
                            class="px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-medium hover:bg-slate-800"
                        >
                            View Patient Log
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</main>

</body>
</html>