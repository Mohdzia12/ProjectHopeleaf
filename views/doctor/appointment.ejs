<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Consultation | HopeLeaf
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-slate-50 text-slate-800">


<div class="min-h-screen">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="bg-white border-b border-slate-200">

        <div
            class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between"
        >

            <div>

                <p class="text-sm text-slate-400">
                    HopeLeaf Doctor Portal
                </p>

                <h1 class="text-2xl font-semibold">
                    Patient Consultation
                </h1>

            </div>


            <a
                href="/doctor/dashboard"
                class="text-sm font-medium text-emerald-600 hover:text-emerald-700"
            >
                ← Back to Dashboard
            </a>

        </div>

    </header>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="max-w-6xl mx-auto px-6 py-8">


        <!-- =================================================
             PATIENT INFORMATION
        ================================================== -->

        <div
            class="bg-white border border-slate-200 rounded-2xl p-6 mb-6"
        >

            <div class="flex flex-col md:flex-row md:justify-between gap-6">


                <div>

                    <p class="text-xs text-slate-400 uppercase tracking-wide">
                        Patient
                    </p>

                    <h2 class="text-2xl font-semibold mt-1">
                        <%= appointment.patient_name %>
                    </h2>

                    <p class="text-sm text-slate-500 mt-1">
                        <%= appointment.patient_email %>
                    </p>

                </div>


                <div class="grid grid-cols-2 gap-8">

                    <div>

                        <p class="text-xs text-slate-400 uppercase tracking-wide">
                            Appointment Date
                        </p>

                        <p class="font-medium mt-1">
                            <%= appointment.date %>
                        </p>

                    </div>


                    <div>

                        <p class="text-xs text-slate-400 uppercase tracking-wide">
                            Time
                        </p>

                        <p class="font-medium mt-1">
                            <%= appointment.time %>
                        </p>

                    </div>

                </div>


            </div>

        </div>



        <!-- =================================================
             PATIENT REASON
        ================================================== -->

        <div
            class="bg-white border border-slate-200 rounded-2xl p-6 mb-6"
        >

            <div class="flex items-center gap-3 mb-4">

                <div class="text-xl">
                    💬
                </div>

                <div>

                    <h2 class="font-semibold text-lg">
                        Patient's Description
                    </h2>

                    <p class="text-xs text-slate-400">
                        Information provided when booking
                    </p>

                </div>

            </div>


            <div
                class="bg-slate-50 rounded-xl p-5 text-sm text-slate-700 leading-relaxed"
            >

                <% if (appointment.reason) { %>

                    <%= appointment.reason %>

                <% } else { %>

                    No description was provided.

                <% } %>

            </div>

        </div>



        <!-- =================================================
             AI SUMMARY
        ================================================== -->

        <div
            class="bg-white border border-emerald-200 rounded-2xl p-6 mb-6"
        >

            <div class="flex items-center justify-between mb-5">


                <div class="flex items-center gap-3">

                    <div class="text-xl">
                        🤖
                    </div>

                    <div>

                        <h2 class="font-semibold text-lg">
                            AI Patient Summary
                        </h2>

                        <p class="text-xs text-slate-400">
                            AI-generated assistance for clinical review
                        </p>

                    </div>

                </div>


                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700"
                >
                    AI Assisted
                </span>

            </div>


            <div
                class="bg-emerald-50/50 border border-emerald-100 rounded-xl p-5"
            >

                <% if (appointment.ai_summary) { %>

                    <p class="text-sm text-slate-700 leading-7 whitespace-pre-line">
                        <%= appointment.ai_summary %>
                    </p>

                <% } else { %>

                    <div class="text-center py-6">

                        <div class="text-3xl mb-3">
                            📝
                        </div>

                        <p class="font-medium">
                            No AI summary available
                        </p>

                        <p class="text-sm text-slate-500 mt-1">
                            The patient's original description is shown above.
                        </p>

                    </div>

                <% } %>

            </div>


            <div class="mt-4 text-xs text-slate-400">

                AI summaries are intended to assist the doctor and
                should be reviewed before making clinical decisions.

            </div>

        </div>



        <!-- =================================================
             GENERATE CLINICAL NOTE
        ================================================== -->

        <div
            class="bg-emerald-600 rounded-2xl p-6 md:p-8 text-white"
        >

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">


                <div>

                    <p class="text-emerald-100 text-sm">
                        Doctor workspace
                    </p>

                    <h2 class="text-xl font-semibold mt-1">
                        Prepare Clinical Note
                    </h2>

                    <p class="text-emerald-50 text-sm mt-2 max-w-xl">
                        Generate a printable HopeLeaf consultation pad
                        containing the patient details and AI summary.
                        You can then add medicines, comments and follow-up
                        instructions.
                    </p>

                </div>


                <a
                    href="/doctor/appointment/<%= appointment._id %>/note"
                    class="inline-flex justify-center items-center px-5 py-3 bg-white text-emerald-700 rounded-xl font-medium text-sm hover:bg-emerald-50 transition"
                >
                    Generate Clinical Note →
                </a>


            </div>

        </div>


    </main>


</div>


</body>

</html>