<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">

```
<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Doctor Dashboard | HopeLeaf</title>

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<style>
    body {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system,
            BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
    }

    html {
        scroll-behavior: smooth;
    }
</style>
```

</head>

<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen flex">

```
<!-- =====================================================
     SIDEBAR
====================================================== -->

<aside
    class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col"
>

    <!-- BRAND -->

    <div class="px-6 py-6 border-b border-slate-100">

        <div class="flex items-center gap-3">

            <div
                class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-sm"
            >
                <i data-lucide="leaf" class="w-5 h-5"></i>
            </div>

            <div>

                <h1 class="text-xl font-bold text-slate-800">
                    HopeLeaf
                </h1>

                <p class="text-xs text-slate-400 mt-0.5">
                    Doctor Portal
                </p>

            </div>

        </div>

    </div>


    <!-- NAVIGATION -->

    <nav class="p-4 space-y-1 flex-1">

        <p
            class="px-4 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
        >
            Workspace
        </p>


        <!-- DASHBOARD -->

        <a
            href="/doctor/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-50 text-emerald-700 font-medium"
        >

            <i
                data-lucide="layout-dashboard"
                class="w-5 h-5"
            ></i>

            <span>
                Dashboard
            </span>

        </a>


        <!-- APPOINTMENTS -->

        <a
            href="#appointments"
            class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
        >

            <i
                data-lucide="calendar-days"
                class="w-5 h-5"
            ></i>

            <span>
                Appointments
            </span>

        </a>


        <!-- PATIENTS -->

        <a
            href="#patients"
            class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
        >

            <i
                data-lucide="users"
                class="w-5 h-5"
            ></i>

            <span>
                Patients
            </span>

        </a>


        <!-- CLINICAL NOTES -->

        <a
            href="#clinical-notes"
            class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
        >

            <i
                data-lucide="notebook-pen"
                class="w-5 h-5"
            ></i>

            <span>
                Clinical Notes
            </span>

        </a>


        <!-- MEDICAL RECORDS -->

        <a
            href="#records"
            class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
        >

            <i
                data-lucide="clipboard-list"
                class="w-5 h-5"
            ></i>

            <span>
                Medical Records
            </span>

        </a>


        <!-- ACCOUNT -->

        <div class="pt-5 mt-5 border-t border-slate-100">

            <p
                class="px-4 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-400"
            >
                Account
            </p>


            <a
                href="#"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-emerald-600 transition"
            >

                <i
                    data-lucide="user-round"
                    class="w-5 h-5"
                ></i>

                <span>
                    My Profile
                </span>

            </a>

        </div>

    </nav>


    <!-- =================================================
         DOCTOR PROFILE
    ================================================== -->

    <div class="p-4 border-t border-slate-100">

        <div
            class="flex items-center gap-3 p-3 mb-3 rounded-xl bg-slate-50"
        >

            <div
                class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-semibold"
            >
                <%= user.name.charAt(0).toUpperCase() %>
            </div>

            <div class="min-w-0">

                <p class="text-sm font-medium truncate">
                    Dr. <%= user.name %>
                </p>

                <p class="text-xs text-slate-400">
                    Doctor
                </p>

            </div>

        </div>


        <!-- LOGOUT -->

        <a
            href="/auth/logout"
            class="flex items-center gap-3 px-4 py-3 text-red-500 hover:bg-red-50 rounded-xl transition"
        >

            <i
                data-lucide="log-out"
                class="w-5 h-5"
            ></i>

            <span>
                Logout
            </span>

        </a>

    </div>

</aside>



<!-- =====================================================
     MAIN
====================================================== -->

<main class="flex-1 min-w-0">


    <!-- =================================================
         TOP NAVBAR
    ================================================== -->

    <header
        class="bg-white border-b border-slate-200 sticky top-0 z-20"
    >

        <div
            class="px-5 md:px-8 py-4 flex items-center justify-between"
        >

            <div>

                <p class="text-xs md:text-sm text-slate-400">
                    Doctor Dashboard
                </p>

                <h2
                    class="text-xl md:text-2xl font-semibold text-slate-800 mt-0.5"
                >
                    Welcome, Dr. <%= user.name %>
                </h2>

            </div>


            <div class="flex items-center gap-4">

                <div class="hidden sm:block text-right">

                    <p class="text-sm font-medium text-slate-700">
                        Dr. <%= user.name %>
                    </p>

                    <p class="text-xs text-slate-400">
                        Healthcare Provider
                    </p>

                </div>


                <div
                    class="w-11 h-11 rounded-full bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-700 font-bold"
                >
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>

            </div>

        </div>

    </header>



    <!-- =================================================
         CONTENT
    ================================================== -->

    <section
        class="p-5 md:p-8 max-w-7xl mx-auto"
    >


        <!-- =================================================
             HERO
        ================================================== -->

        <div
            class="relative overflow-hidden bg-emerald-600 rounded-3xl p-7 md:p-9 text-white mb-8 shadow-sm"
        >

            <div class="relative z-10 max-w-2xl">

                <div class="flex items-center gap-2 mb-3">

                    <div
                        class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center"
                    >

                        <i
                            data-lucide="stethoscope"
                            class="w-4 h-4"
                        ></i>

                    </div>

                    <p class="text-emerald-100 text-sm font-medium">
                        Doctor Workspace
                    </p>

                </div>


                <h3
                    class="text-2xl md:text-3xl font-bold"
                >
                    Good to see you, Dr. <%= user.name %>
                </h3>


                <p
                    class="text-emerald-50 mt-3 leading-relaxed max-w-xl"
                >
                    Manage your appointments, review patient information,
                    and prepare consultation notes from one secure workspace.
                </p>

            </div>


            <!-- DECORATIVE SHAPES -->

            <div
                class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-white/10"
            ></div>

            <div
                class="absolute -right-10 -bottom-24 w-48 h-48 rounded-full bg-white/10"
            ></div>

        </div>



        <!-- =================================================
             QUICK STATS
        ================================================== -->

        <div
            class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10"
        >


            <!-- APPOINTMENTS -->

            <div
                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-emerald-200 transition"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p class="text-sm text-slate-400">
                            Appointments
                        </p>

                        <p class="text-2xl font-bold mt-1 text-slate-800">
                            <%= appointments ? appointments.length : 0 %>
                        </p>

                    </div>


                    <div
                        class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center"
                    >

                        <i
                            data-lucide="calendar-days"
                            class="w-5 h-5"
                        ></i>

                    </div>

                </div>


                <p class="text-xs text-slate-400 mt-3">
                    Scheduled in your workspace
                </p>

            </div>



            <!-- PATIENTS -->

            <div
                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-blue-200 transition"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p class="text-sm text-slate-400">
                            Patients
                        </p>

                        <p class="text-2xl font-bold mt-1 text-slate-800">
                            <%= appointments ? appointments.length : 0 %>
                        </p>

                    </div>


                    <div
                        class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center"
                    >

                        <i
                            data-lucide="users"
                            class="w-5 h-5"
                        ></i>

                    </div>

                </div>


                <p class="text-xs text-slate-400 mt-3">
                    Patients linked to appointments
                </p>

            </div>



            <!-- WORKSPACE STATUS -->

            <div
                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-green-200 transition"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p class="text-sm text-slate-400">
                            Workspace
                        </p>

                        <p class="text-2xl font-bold mt-1 text-slate-800">
                            Active
                        </p>

                    </div>


                    <div
                        class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center"
                    >

                        <i
                            data-lucide="circle-check"
                            class="w-5 h-5"
                        ></i>

                    </div>

                </div>


                <p class="text-xs text-slate-400 mt-3">
                    HopeLeaf clinical workspace
                </p>

            </div>

        </div>



        <!-- =================================================
             APPOINTMENTS
        ================================================== -->

        <div
            id="appointments"
            class="mb-12"
        >

            <div
                class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5"
            >

                <div>

                    <p class="text-sm text-slate-400">
                        Your schedule
                    </p>

                    <h3
                        class="text-xl md:text-2xl font-semibold mt-1"
                    >
                        Upcoming Appointments
                    </h3>

                </div>


                <div
                    class="inline-flex items-center gap-2 text-sm text-slate-400"
                >

                    <i
                        data-lucide="calendar-check"
                        class="w-4 h-4"
                    ></i>

                    <span>
                        <%= appointments ? appointments.length : 0 %>
                        appointment(s)
                    </span>

                </div>

            </div>



            <!-- EMPTY STATE -->

            <% if (!appointments || appointments.length === 0) { %>

                <div
                    class="bg-white border border-slate-200 rounded-2xl p-10 text-center"
                >

                    <div
                        class="mx-auto w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4"
                    >

                        <i
                            data-lucide="calendar-x-2"
                            class="w-7 h-7"
                        ></i>

                    </div>


                    <h4 class="font-semibold text-lg">
                        No upcoming appointments
                    </h4>


                    <p
                        class="text-sm text-slate-500 mt-2 max-w-md mx-auto"
                    >
                        Your scheduled patient appointments will appear
                        here once they are available.
                    </p>

                </div>


            <% } else { %>


                <!-- APPOINTMENT LIST -->

                <div class="space-y-4">

                    <% appointments.forEach(function(appointment) { %>


                        <div
                            class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 hover:border-emerald-300 hover:shadow-sm transition"
                        >

                            <div
                                class="flex flex-col lg:flex-row lg:items-center gap-6"
                            >


                                <!-- PATIENT -->

                                <div
                                    class="flex items-center gap-4 flex-1 min-w-0"
                                >

                                    <div
                                        class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-lg flex-shrink-0"
                                    >
                                        <%= appointment.patient_name.charAt(0).toUpperCase() %>
                                    </div>


                                    <div class="min-w-0">

                                        <p
                                            class="text-xs text-slate-400 uppercase tracking-wide"
                                        >
                                            Patient
                                        </p>


                                        <h4
                                            class="font-semibold text-lg mt-1 truncate"
                                        >
                                            <%= appointment.patient_name %>
                                        </h4>


                                        <p
                                            class="text-sm text-slate-500 truncate mt-1"
                                        >
                                            <%= appointment.patient_email %>
                                        </p>

                                    </div>

                                </div>



                                <!-- DATE -->

                                <div class="lg:w-32">

                                    <p
                                        class="text-xs text-slate-400 uppercase tracking-wide"
                                    >
                                        Date
                                    </p>


                                    <div
                                        class="flex items-center gap-2 mt-1"
                                    >

                                        <i
                                            data-lucide="calendar"
                                            class="w-4 h-4 text-slate-400"
                                        ></i>

                                        <p
                                            class="text-sm font-semibold"
                                        >
                                            <%= appointment.date %>
                                        </p>

                                    </div>

                                </div>



                                <!-- TIME -->

                                <div class="lg:w-28">

                                    <p
                                        class="text-xs text-slate-400 uppercase tracking-wide"
                                    >
                                        Time
                                    </p>


                                    <div
                                        class="flex items-center gap-2 mt-1"
                                    >

                                        <i
                                            data-lucide="clock-3"
                                            class="w-4 h-4 text-slate-400"
                                        ></i>

                                        <p
                                            class="text-sm font-semibold"
                                        >
                                            <%= appointment.time %>
                                        </p>

                                    </div>

                                </div>



                                <!-- STATUS -->

                                <div>

                                    <% if (appointment.status === "scheduled") { %>

                                        <span
                                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700"
                                        >

                                            <span
                                                class="w-1.5 h-1.5 rounded-full bg-emerald-500"
                                            ></span>

                                            Scheduled

                                        </span>


                                    <% } else if (appointment.status === "completed") { %>

                                        <span
                                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700"
                                        >

                                            <i
                                                data-lucide="check"
                                                class="w-3.5 h-3.5"
                                            ></i>

                                            Completed

                                        </span>


                                    <% } else if (appointment.status === "cancelled") { %>

                                        <span
                                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-red-50 text-red-700"
                                        >

                                            <i
                                                data-lucide="x"
                                                class="w-3.5 h-3.5"
                                            ></i>

                                            Cancelled

                                        </span>


                                    <% } else { %>

                                        <span
                                            class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600"
                                        >
                                            <%= appointment.status %>
                                        </span>

                                    <% } %>

                                </div>



                                <!-- VIEW CONSULTATION -->

                                <div>

                                    <a
                                        href="/doctor/appointment/<%= appointment._id %>"
                                        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition w-full lg:w-auto"
                                    >

                                        <span>
                                            View Consultation
                                        </span>

                                        <i
                                            data-lucide="arrow-right"
                                            class="w-4 h-4"
                                        ></i>

                                    </a>

                                </div>

                            </div>



                            <!-- REASON -->

                            <% if (appointment.reason) { %>

                                <div
                                    class="mt-5 pt-4 border-t border-slate-100"
                                >

                                    <p
                                        class="text-xs text-slate-400 uppercase tracking-wide"
                                    >
                                        Patient's Reason
                                    </p>


                                    <p
                                        class="text-sm text-slate-600 mt-2 leading-relaxed"
                                    >
                                        <%= appointment.reason %>
                                    </p>

                                </div>

                            <% } %>

                        </div>


                    <% }) %>

                </div>


            <% } %>

        </div>



        <!-- =================================================
             DOCTOR WORKSPACE
        ================================================== -->

        <div>

            <div class="mb-5">

                <p class="text-sm text-slate-400">
                    Clinical tools
                </p>

                <h3
                    class="text-xl md:text-2xl font-semibold mt-1"
                >
                    Doctor Workspace
                </h3>

            </div>


            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-5"
            >


                <!-- =================================================
                     PATIENTS
                ================================================== -->

                <div
                    id="patients"
                    class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-blue-300 hover:shadow-sm transition"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5"
                    >

                        <i
                            data-lucide="users"
                            class="w-6 h-6"
                        ></i>

                    </div>


                    <h3 class="font-semibold text-lg">
                        Patients
                    </h3>


                    <p
                        class="text-sm text-slate-500 mt-2 leading-relaxed"
                    >
                        View patients connected to your appointments
                        and access their available information.
                    </p>


                    <div
                        class="mt-5 flex items-center gap-2 text-sm font-semibold text-slate-400"
                    >

                        <span>
                            Patient management
                        </span>

                        <i
                            data-lucide="chevron-right"
                            class="w-4 h-4"
                        ></i>

                    </div>

                </div>



                <!-- =================================================
                     CLINICAL NOTES
                ================================================== -->

                <div
                    id="clinical-notes"
                    class="bg-white border border-emerald-200 rounded-2xl p-6 hover:border-emerald-400 hover:shadow-sm transition"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5"
                    >

                        <i
                            data-lucide="notebook-pen"
                            class="w-6 h-6"
                        ></i>

                    </div>


                    <h3 class="font-semibold text-lg">
                        Clinical Notes
                    </h3>


                    <p
                        class="text-sm text-slate-500 mt-2 leading-relaxed"
                    >
                        Review patient summaries and prepare
                        printable consultation notes.
                    </p>


                    <div
                        class="mt-5 flex items-center gap-2 text-sm font-semibold text-emerald-600"
                    >

                        <span>
                            Consultation workspace
                        </span>

                        <i
                            data-lucide="arrow-right"
                            class="w-4 h-4"
                        ></i>

                    </div>

                </div>



                <!-- =================================================
                     MEDICAL RECORDS
                ================================================== -->

                <div
                    id="records"
                    class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-purple-300 hover:shadow-sm transition"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-5"
                    >

                        <i
                            data-lucide="clipboard-list"
                            class="w-6 h-6"
                        ></i>

                    </div>


                    <h3 class="font-semibold text-lg">
                        Medical Records
                    </h3>


                    <p
                        class="text-sm text-slate-500 mt-2 leading-relaxed"
                    >
                        Patient records and consultation documents
                        will be available here.
                    </p>


                    <div
                        class="mt-5 flex items-center gap-2 text-sm font-semibold text-slate-400"
                    >

                        <span>
                            Records workspace
                        </span>

                        <i
                            data-lucide="chevron-right"
                            class="w-4 h-4"
                        ></i>

                    </div>

                </div>


            </div>

        </div>



        <!-- =================================================
             SECURITY NOTE
        ================================================== -->

        <div
            class="mt-10 bg-slate-100 border border-slate-200 rounded-2xl p-5"
        >

            <div class="flex gap-3">

                <div
                    class="w-9 h-9 rounded-lg bg-white flex items-center justify-center text-slate-600 flex-shrink-0"
                >

                    <i
                        data-lucide="shield-check"
                        class="w-5 h-5"
                    ></i>

                </div>


                <div>

                    <h4 class="font-semibold text-sm">
                        Secure clinical workspace
                    </h4>


                    <p
                        class="text-xs text-slate-500 mt-1 leading-relaxed"
                    >
                        Patient information displayed in this dashboard
                        is associated with your HopeLeaf account and
                        appointments. Please handle clinical information
                        according to your organization's privacy policies.
                    </p>

                </div>

            </div>

        </div>


    </section>

</main>
```

</div>

<!-- =====================================================
     INITIALIZE LUCIDE ICONS
====================================================== -->

<script>
    lucide.createIcons();
</script>

</body>
</html>
