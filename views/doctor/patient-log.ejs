<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Patient Log | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-slate-50 text-slate-800">

    <!-- TOP NAV -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                    <i data-lucide="leaf" class="w-5 h-5 text-emerald-600"></i>
                </div>

                <div>
                    <h1 class="text-lg font-bold text-slate-900">
                        HopeLeaf
                    </h1>
                    <p class="text-xs text-slate-500">
                        Doctor Portal
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-5">

                <div class="hidden sm:block text-right">
                    <p class="text-sm font-semibold text-slate-900">
                        Dr. <%= user.name %>
                    </p>

                    <p class="text-xs text-slate-500">
                        Doctor
                    </p>
                </div>

                <a
                    href="/auth/logout"
                    class="flex items-center gap-2 px-4 py-2 rounded-lg
                           text-sm font-medium text-slate-600
                           hover:bg-slate-100 transition"
                >
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    Logout
                </a>

            </div>

        </div>
    </header>


    <!-- MAIN -->
    <main class="max-w-6xl mx-auto px-6 py-8">

        <!-- BACK -->
        <div class="mb-6">

            <a
                href="/doctor/patient-logs"
                class="inline-flex items-center gap-2
                       text-sm font-medium text-slate-600
                       hover:text-emerald-600 transition"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Patient Logs
            </a>

        </div>


        <!-- PAGE HEADER -->
        <div class="mb-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>

                    <p class="text-sm font-medium text-emerald-600 mb-1">
                        Nursing Report
                    </p>

                    <h2 class="text-3xl font-bold text-slate-900">
                        Patient Log
                    </h2>

                    <p class="text-slate-500 mt-2">
                        Review observations and clinical information submitted by the nursing team.
                    </p>

                </div>


                <!-- PRIORITY -->
                <div>

                    <% if (log.priority === "high" || log.priority === "urgent") { %>

                        <span class="inline-flex items-center gap-2 px-4 py-2
                                     rounded-full bg-red-100 text-red-700
                                     text-sm font-semibold">

                            <i data-lucide="triangle-alert" class="w-4 h-4"></i>

                            <%= log.priority %>

                        </span>

                    <% } else { %>

                        <span class="inline-flex items-center gap-2 px-4 py-2
                                     rounded-full bg-slate-100 text-slate-700
                                     text-sm font-semibold">

                            <i data-lucide="flag" class="w-4 h-4"></i>

                            <%= log.priority || "Normal" %>

                        </span>

                    <% } %>

                </div>

            </div>

        </div>


        <!-- PATIENT SUMMARY -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6">

            <div class="p-6 border-b border-slate-200">

                <div class="flex items-center gap-4">

                    <div class="w-14 h-14 rounded-2xl bg-emerald-100
                                flex items-center justify-center">

                        <i data-lucide="user-round"
                           class="w-7 h-7 text-emerald-600"></i>

                    </div>

                    <div>

                        <h3 class="text-xl font-bold text-slate-900">
                            <%= log.patient_name || "Unknown Patient" %>
                        </h3>

                        <p class="text-sm text-slate-500 mt-1">
                            Patient ID:
                            <span class="font-mono">
                                <%= log.patient_id %>
                            </span>
                        </p>

                    </div>

                </div>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6">

                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold">
                        Submitted By
                    </p>

                    <p class="mt-2 font-semibold text-slate-800">
                        <%= log.nurse_name || "Nursing Staff" %>
                    </p>
                </div>


                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold">
                        Status
                    </p>

                    <p class="mt-2 font-semibold text-slate-800 capitalize">
                        <%= log.status || "Sent" %>
                    </p>
                </div>


                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold">
                        Submitted
                    </p>

                    <p class="mt-2 font-semibold text-slate-800">
                        <%= log.created_at
                            ? new Date(log.created_at).toLocaleString()
                            : "Not available"
                        %>
                    </p>
                </div>

            </div>

        </section>


        <!-- CLINICAL INFORMATION -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- OBSERVATIONS -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-blue-100
                                flex items-center justify-center">

                        <i data-lucide="eye"
                           class="w-5 h-5 text-blue-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Observations
                        </h3>

                        <p class="text-xs text-slate-500">
                            General nursing observations
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.observations || "No observations recorded." %>

                </div>

            </div>


            <!-- SYMPTOMS -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-amber-100
                                flex items-center justify-center">

                        <i data-lucide="activity"
                           class="w-5 h-5 text-amber-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Symptoms
                        </h3>

                        <p class="text-xs text-slate-500">
                            Reported symptoms
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.symptoms || "No symptoms recorded." %>

                </div>

            </div>


            <!-- VITAL NOTES -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-red-100
                                flex items-center justify-center">

                        <i data-lucide="heart-pulse"
                           class="w-5 h-5 text-red-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Vital Notes
                        </h3>

                        <p class="text-xs text-slate-500">
                            Vital signs and related notes
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.vital_notes || "No vital notes recorded." %>

                </div>

            </div>


            <!-- PAIN / COMFORT -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-purple-100
                                flex items-center justify-center">

                        <i data-lucide="smile"
                           class="w-5 h-5 text-purple-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Pain & Comfort
                        </h3>

                        <p class="text-xs text-slate-500">
                            Comfort assessment
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.pain_comfort || "No pain or comfort notes recorded." %>

                </div>

            </div>


            <!-- MEDICATION -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-green-100
                                flex items-center justify-center">

                        <i data-lucide="pill"
                           class="w-5 h-5 text-green-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Medication Notes
                        </h3>

                        <p class="text-xs text-slate-500">
                            Medication-related information
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.medication_notes || "No medication notes recorded." %>

                </div>

            </div>


            <!-- ADDITIONAL -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="w-10 h-10 rounded-xl bg-slate-100
                                flex items-center justify-center">

                        <i data-lucide="clipboard-list"
                           class="w-5 h-5 text-slate-600"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-900">
                            Additional Notes
                        </h3>

                        <p class="text-xs text-slate-500">
                            Other information from nursing staff
                        </p>

                    </div>

                </div>

                <div class="text-sm text-slate-700 leading-7 whitespace-pre-line">

                    <%= log.additional_notes || "No additional notes recorded." %>

                </div>

            </div>

        </section>


        <!-- FOOTER ACTION -->
        <div class="mt-8 flex justify-between items-center">

            <a
                href="/doctor/patient-logs"
                class="inline-flex items-center gap-2 px-5 py-3
                       rounded-xl bg-white border border-slate-200
                       text-sm font-semibold text-slate-700
                       hover:bg-slate-50 transition"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                All Patient Logs
            </a>

            <div class="text-xs text-slate-400">
                HopeLeaf Clinical Workspace
            </div>

        </div>

    </main>


    <script>
        lucide.createIcons();
    </script>

</body>
</html>