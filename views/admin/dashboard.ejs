<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | HopeLeaf</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col">

        <div class="p-6 border-b border-slate-100">

            <h1 class="text-2xl font-bold text-emerald-600">
                HopeLeaf
            </h1>

            <p class="text-xs text-slate-400 mt-1">
                Admin Portal
            </p>

        </div>

        <nav class="p-4 space-y-2 flex-1">

            <a
                href="/admin/dashboard"
                class="block px-4 py-3 rounded-xl bg-emerald-50 text-emerald-700 font-medium"
            >
                Dashboard
            </a>

            <a
                href="#"
                class="block px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50"
            >
                Users
            </a>

        </nav>

        <div class="p-4 border-t border-slate-100">

            <a
                href="/auth/logout"
                class="block px-4 py-3 text-red-500 hover:bg-red-50 rounded-xl"
            >
                Logout
            </a>

        </div>

    </aside>

    <!-- Main -->
    <main class="flex-1">

        <header class="bg-white border-b border-slate-200">

            <div class="px-6 py-5 flex items-center justify-between">

                <div>

                    <p class="text-sm text-slate-400">
                        Administration
                    </p>

                    <h2 class="text-2xl font-semibold">
                        Welcome, <%= user.name %>
                    </h2>

                </div>

                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-semibold">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>

            </div>

        </header>

        <section class="p-6 md:p-8 max-w-7xl mx-auto">

            <div class="bg-emerald-600 rounded-2xl p-6 md:p-8 text-white mb-8">

                <p class="text-emerald-100 text-sm">
                    System administration
                </p>

                <h3 class="text-2xl font-semibold mt-2">
                    HopeLeaf Overview
                </h3>

                <p class="text-emerald-50 mt-2 max-w-xl">
                    Manage the HopeLeaf healthcare platform from here.
                </p>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div class="bg-white border border-slate-200 rounded-2xl p-6">

                    <div class="text-2xl mb-4">
                        👥
                    </div>

                    <h3 class="font-semibold text-lg">
                        Users
                    </h3>

                    <p class="text-sm text-slate-500 mt-2">
                        Manage patients and doctors.
                    </p>

                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-6">

                    <div class="text-2xl mb-4">
                        🩺
                    </div>

                    <h3 class="font-semibold text-lg">
                        Doctors
                    </h3>

                    <p class="text-sm text-slate-500 mt-2">
                        View registered doctors.
                    </p>

                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-6">

                    <div class="text-2xl mb-4">
                        📊
                    </div>

                    <h3 class="font-semibold text-lg">
                        System
                    </h3>

                    <p class="text-sm text-slate-500 mt-2">
                        Platform information will appear here.
                    </p>

                </div>

            </div>

        </section>

    </main>

</div>

</body>

</html>