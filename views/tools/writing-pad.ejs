     JAVASCRIPT
========================================================== -->

<script>

    const fields = {

        hospitalName: "previewHospitalName",
        hospitalAddress: "previewHospitalAddress",
        hospitalPhone: "previewHospitalPhone",
        hospitalEmail: "previewHospitalEmail",

        doctorName: "previewDoctorName",
        doctorQualification: "previewDoctorQualification",
        doctorRegistration: "previewDoctorRegistration",

        patientName: "previewPatientName",
        patientAge: "previewPatientAge",
        patientGender: "previewPatientGender",
        patientId: "previewPatientId",

        bloodPressure: "previewBP",
        pulse: "previewPulse",
        temperature: "previewTemperature",
        weight: "previewWeight",
        height: "previewHeight",
        spo2: "previewSpo2",

        complaint: "previewComplaint",
        history: "previewHistory",
        examination: "previewExamination",
        assessment: "previewAssessment",
        prescription: "previewPrescription",
        advice: "previewAdvice",
        followUp: "previewFollowUp"

    };


    function updatePreview() {

        Object.keys(fields).forEach(function(fieldId) {

            const input = document.getElementById(fieldId);
            const output = document.getElementById(fields[fieldId]);

            if (!input || !output) {
                return;
            }

            const value = input.value.trim();

            output.textContent = value || "—";

        });

    }


    Object.keys(fields).forEach(function(fieldId) {

        const input = document.getElementById(fieldId);

        if (!input) {
            return;
        }

        input.addEventListener("input", updatePreview);
        input.addEventListener("change", updatePreview);

    });


    function setCurrentDate() {

        const dateElement = document.getElementById("previewDate");

        const today = new Date();

        dateElement.textContent = today.toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );

    }


    function clearForm() {

        const inputs = document.querySelectorAll(
            "input, textarea, select"
        );

        inputs.forEach(function(input) {

            input.value = "";

        });

        updatePreview();

        setCurrentDate();

    }


    setCurrentDate();
    updatePreview();

</script>
